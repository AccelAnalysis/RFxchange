# RFxchange runtime environment role.
# Allowed values: development | staging | production
RFXCHANGE_ENV=development

# Environment-safety binding used by server and Cloud Functions runtime composition.
# Set this to the Firebase project expected for the selected RFxchange environment.
RFXCHANGE_EXPECTED_PROJECT_ID=replace-with-intended-firebase-project-id

# Canonical public origin used to construct signed acquisition continuation links.
# Set the exact deployed origin per environment; do not include a path, query, or fragment.
RFXCHANGE_PUBLIC_ORIGIN=http://localhost:3000

# Local development against a REAL Firebase project also needs a server-side Firebase Admin
# identity. Prefer Google Application Default Credentials. One local pattern is to point this
# variable at a service-account JSON file stored OUTSIDE the repository. The path is configuration;
# the credential file itself is secret and must never be committed.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/local/path/to/firebase-admin-service-account.json

# Server-side Firebase Storage bucket name. Use only the bucket name (no gs:// or https://).
# This is configuration, not a secret, and must identify the bucket for the selected environment.
RFXCHANGE_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket

# Firebase web application configuration.
# Firebase web config identifies the Firebase project/app; these are not service-account secrets.
# Replace locally after registering the RFxchange Web App in the intended Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id

# Mapbox GL JS browser configuration.
# Use a PUBLIC Mapbox access token that starts with "pk.". This value is intentionally exposed
# to the browser by Next.js; restrict it to the approved RFxchange origins in Mapbox when possible.
# Never place a Mapbox secret token ("sk.") in a NEXT_PUBLIC_* variable or client-side code.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.replace-with-public-mapbox-access-token

# OPTIONAL local Auth emulator. Leave this UNSET to use the Firebase project configured above.
# Set it only when intentionally running the local Firebase Auth emulator.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Cloud Functions receives RFXCHANGE_ENV and RFXCHANGE_EXPECTED_PROJECT_ID as server-side
# environment configuration. Provider secrets must use managed secret parameters/Secret Manager.
# Never place Firebase service-account private keys, refresh tokens, Stripe secrets,
# Microsoft credentials, Mapbox secret tokens, or other privileged provider secrets in this
# committed file.

# MRFC Critical Founding checkout release policy. Missing or invalid configuration also fails closed.
# Keep production at `closed` through deploy, secret/webhook binding and smoke testing.
# `proof` permits only RFXCHANGE_FOUNDING_PROOF_ORGANIZATION_ID; `open` requires later explicit
# Control Room authorization after the bounded live proof and applicable independent acceptance.
RFXCHANGE_FOUNDING_CHECKOUT_RELEASE_MODE=closed
# RFXCHANGE_FOUNDING_PROOF_ORGANIZATION_ID=replace-with-exact-authorized-proof-organization-id

# Stripe mode and non-secret Price binding. The approved production Price is intentionally explicit;
# the Stripe secret key and webhook signing secret must be supplied only via the deployment secret
# mechanism / Secret Manager and are intentionally absent from this committed file.
RFXCHANGE_STRIPE_MODE=test
RFXCHANGE_FOUNDING_STRIPE_PRICE_ID=price_1U44szPNrfGaFz2qxcWEKKRl
RFXCHANGE_FOUNDING_STRIPE_TEST_PRICE_ID=replace-with-test-mode-founding-price-id
# STRIPE_SECRET_KEY=<managed secret only>
# STRIPE_WEBHOOK_SECRET=<managed secret only>

# COMMS-002 Microsoft Graph transactional email runtime configuration.
# Tenant/client/sender values identify the approved app and sender for one environment.
# RFXCHANGE_MICROSOFT_CLIENT_SECRET must be supplied through managed secrets and is intentionally
# omitted here. Live acceptance also requires an explicit opt-in and controlled recipient.
RFXCHANGE_MICROSOFT_EXPECTED_ENV=development
RFXCHANGE_MICROSOFT_TENANT_ID=replace-with-microsoft-tenant-id
RFXCHANGE_MICROSOFT_CLIENT_ID=replace-with-microsoft-application-client-id
RFXCHANGE_MICROSOFT_APPROVED_SENDER=replace-with-approved-rfxchange-sender
# RFXCHANGE_MICROSOFT_GRAPH_TIMEOUT_MS=15000
# RFXCHANGE_ALLOW_LIVE_MICROSOFT_EMAIL_ACCEPTANCE=false
# RFXCHANGE_MICROSOFT_EMAIL_ACCEPTANCE_RECIPIENT=controlled-recipient@example.test