# Never place Firebase service-account private keys, refresh tokens, Stripe secrets,
# Microsoft credentials, Mapbox secret tokens, or other privileged provider secrets in this
# committed file.

# MRFC Critical Founding checkout release policy. Missing or invalid configuration also fails closed.
# Keep production at `closed` through deploy, secret/webhook binding and smoke testing.
# `proof` permits only RFXCHANGE_FOUNDING_PROOF_ORGANIZATION_ID; `open` requires later explicit
# Control Room authorization after the bounded live proof and applicable independent acceptance.
RFXCHANGE_FOUNDING_CHECKOUT_RELEASE_MODE=closed
# RFXCHANGE_FOUNDING_PROOF_ORGANIZATION_ID=replace-with-exact-authorized-proof-organization-id

# Stripe mode and non-secret Price binding. The approved production Price is intentionally explicit;
# the Stripe secret key and webhook signing secret must be supplied only via the deployment secret
# mechanism / Secret Manager and are intentionally absent from this committed file.
RFXCHANGE_STRIPE_MODE=test
RFXCHANGE_FOUNDING_STRIPE_PRICE_ID=price_1U44szPNrfGaFz2qxcWEKKRl
RFXCHANGE_FOUNDING_STRIPE_TEST_PRICE_ID=replace-with-test-mode-founding-price-id
# STRIPE_SECRET_KEY=<managed secret only>
# STRIPE_WEBHOOK_SECRET=<managed secret only>

# COMMS-002 Microsoft Graph transactional email runtime configuration.
# Tenant/client/sender values identify the approved app and sender for one environment.
# RFXCHANGE_MICROSOFT_CLIENT_SECRET must be supplied through managed secrets and is intentionally
# omitted here. Live acceptance also requires an explicit opt-in and controlled recipient.
RFXCHANGE_MICROSOFT_EXPECTED_ENV=development
RFXCHANGE_MICROSOFT_TENANT_ID=replace-with-microsoft-tenant-id
RFXCHANGE_MICROSOFT_CLIENT_ID=replace-with-microsoft-application-client-id
RFXCHANGE_MICROSOFT_APPROVED_SENDER=replace-with-approved-rfxchange-sender
# RFXCHANGE_MICROSOFT_GRAPH_TIMEOUT_MS=15000
# RFXCHANGE_ALLOW_LIVE_MICROSOFT_EMAIL_ACCEPTANCE=false
# RFXCHANGE_MICROSOFT_EMAIL_ACCEPTANCE_RECIPIENT=controlled-recipient@example.test