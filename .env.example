# RFxchange runtime environment role.
# Allowed values: development | staging | production
RFXCHANGE_ENV=development

# Firebase web application configuration.
# Firebase web config identifies the Firebase project/app; these are not service-account secrets.
# Replace locally after registering the RFxchange Web App in the intended Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id

# Local Auth emulator. AUTH-001 connects only in non-production builds and only to localhost/http.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Never place Firebase service-account private keys, refresh tokens, Stripe secrets,
# Microsoft credentials, or other privileged provider secrets in this committed file.
