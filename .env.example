# RFxchange runtime environment role.
# Allowed values: development | staging | production
RFXCHANGE_ENV=development

# Environment-safety binding used by server and Cloud Functions runtime composition.
# Set this to the Firebase project expected for the selected RFxchange environment.
RFXCHANGE_EXPECTED_PROJECT_ID=replace-with-intended-firebase-project-id

# Server-side Firebase Storage bucket name. Use only the bucket name (no gs:// or https://).
# This is configuration, not a secret, and must identify the bucket for the selected environment.
RFXCHANGE_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket

# Firebase web application configuration.
# Firebase web config identifies the Firebase project/app; these are not service-account secrets.
# Replace locally after registering the RFxchange Web App in the intended Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id

# Local Auth emulator. AUTH-001 connects only in non-production builds and only to localhost/http.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Cloud Functions receives RFXCHANGE_ENV and RFXCHANGE_EXPECTED_PROJECT_ID as server-side
# environment configuration. Provider secrets must use managed secret parameters/Secret Manager.
# Never place Firebase service-account private keys, refresh tokens, Stripe secrets,
# Microsoft credentials, or other privileged provider secrets in this committed file.

# COMMS-002 Microsoft Graph transactional email runtime configuration.
# Tenant/client/sender values identify the approved app and sender for one environment.
# RFXCHANGE_MICROSOFT_CLIENT_SECRET must be supplied through managed secrets and is intentionally
# omitted here. Live acceptance also requires an explicit opt-in and controlled recipient.
RFXCHANGE_MICROSOFT_EXPECTED_ENV=development
RFXCHANGE_MICROSOFT_TENANT_ID=replace-with-microsoft-tenant-id
RFXCHANGE_MICROSOFT_CLIENT_ID=replace-with-microsoft-application-client-id
RFXCHANGE_MICROSOFT_APPROVED_SENDER=replace-with-approved-rfxchange-sender
# RFXCHANGE_MICROSOFT_GRAPH_TIMEOUT_MS=15000
# RFXCHANGE_ALLOW_LIVE_MICROSOFT_EMAIL_ACCEPTANCE=false
# RFXCHANGE_MICROSOFT_EMAIL_ACCEPTANCE_RECIPIENT=controlled-recipient@example.test
