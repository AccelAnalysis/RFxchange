rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // INF-004 establishes a server-managed Firestore boundary.
    // The Firebase Admin SDK bypasses Firestore Security Rules and is governed by IAM.
    // AUTH-005 proves that authenticated and unauthenticated direct clients remain denied while
    // verified server operations apply RFxchange identity, membership, restriction, and permission checks.
    function serverManagedOnly() {
      return false;
    }

    match /organizations/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /organizationProfiles/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /users/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /organizationMemberships/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /organizationAuthorizations/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /organizationUserInvitations/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /organizationRoleBundles/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    // ADM-061 canonical administrative cases are mutable workflow aggregates; lifecycle events are
    // immutable evidence and may only be appended by the trusted server boundary.
    match /administrativeCases/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /administrativeCaseEvents/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    // ADM-083 governed policy values are server-managed configuration. Changes are authorized and
    // audited by the application layer rather than exposed as direct client writes.
    match /governedConfigurationValues/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    // ADM-085/086 administrative history and corrections share one append-only evidence stream.
    match /platformAdministrativeAuditEvents/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /organizationAuditEvents/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /accessJourneys/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /accessRestrictions/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /legalDocumentVersions/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /legalAcknowledgements/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /organizationAuthorityRepresentations/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /platformChangeDirectives/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /retentionPolicies/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /retentionAssignments/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /adminAuthorityContexts/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /adminPermissionGrants/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /backgroundJobs/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /backgroundJobEvents/{documentId} {
      allow read, create: if serverManagedOnly();
      allow update, delete: if false;
    }

    match /storedAssets/{documentId} {
      allow read, write: if serverManagedOnly();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
