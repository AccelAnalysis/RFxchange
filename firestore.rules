rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // INF-004 establishes a server-managed Firestore boundary.
    // The Firebase Admin SDK bypasses Firestore Security Rules and is governed by IAM.
    // AUTH-005 proves that authenticated and unauthenticated direct clients remain denied while
    // verified server operations apply RFxchange identity, membership, restriction, and permission checks.
    function serverManagedOnly() {
      return false;
    }

    match /organizations/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationProfiles/{documentId} { allow read, write: if serverManagedOnly(); }

    // ACQ-004 / ORG-001 discovery data is projected by trusted server handlers; resolution-only
    // identity signals are never directly readable by browser clients.
    match /organizationDiscoveryRecords/{documentId} { allow read, write: if serverManagedOnly(); }

    // ORG-002/003 participant decisions and strong entity-key reservations are immutable evidence.
    match /organizationResolutions/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /organizationEntityKeys/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    // ORG-004 claim state is mutable only through trusted authority services. Workflow events and
    // decisions preserve append-only evidence, including denied and conflicting claims.
    match /organizationAuthorityClaims/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationAuthorityClaimEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /organizationAuthorityDecisions/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    // GEO-009/010 and ORG-005/006/009 keep private address/geocode state behind trusted
    // organization authorization. Location events remain immutable evidence.
    match /organizationLocationDrafts/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationLocations/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationLocationEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /organizationServiceGeographies/{documentId} { allow read, write: if serverManagedOnly(); }

    // ORG-007/008/010/011/012 essential profile completion is server derived from the
    // canonical organization profile, location and service-geography records.
    match /organizationProfileCompletions/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationProfileEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    // ORG-013/014/016/017 market enrichment is organization-scoped and server-authorized.
    match /organizationCapabilityClaims/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationIndustryProfiles/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationPastPerformance/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationMarketPreferences/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationProvisionalTerms/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /organizationMarketProfileEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /organizationMarketProfileCommands/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    // ORG-015/018/019 credential, media and subordinate-location enrichment is server-authorized.
    match /organizationCredentials/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationProfileAssets/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationAdditionalLocationDrafts/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationAdditionalLocations/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationEnrichmentEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /organizationEnrichmentCommands/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    // GEO-011 marker activation is a server-derived lifecycle aggregate.
    match /organizationMarkerActivations/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationMarkerEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    match /users/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationMemberships/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationAuthorizations/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationUserInvitations/{documentId} { allow read, write: if serverManagedOnly(); }
    match /organizationRoleBundles/{documentId} { allow read, write: if serverManagedOnly(); }

    match /administrativeCases/{documentId} { allow read, write: if serverManagedOnly(); }
    match /administrativeCaseEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /governedConfigurationValues/{documentId} { allow read, write: if serverManagedOnly(); }
    match /governedConfigurationChanges/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /featureFlagStates/{documentId} { allow read, write: if serverManagedOnly(); }
    match /featureFlagChanges/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /systemMaintenanceOperations/{documentId} { allow read, write: if serverManagedOnly(); }
    match /platformAdministrativeAuditEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /organizationAuditEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    match /geographies/{documentId} { allow read, write: if serverManagedOnly(); }
    match /primaryGeographySelections/{documentId} { allow read, write: if serverManagedOnly(); }
    match /geographyParticipationAuthorizations/{documentId} { allow read, write: if serverManagedOnly(); }
    match /accessJourneys/{documentId} { allow read, write: if serverManagedOnly(); }
    match /accessRestrictions/{documentId} { allow read, write: if serverManagedOnly(); }
    match /legalDocumentVersions/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /legalAcknowledgements/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /organizationAuthorityRepresentations/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /platformChangeDirectives/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /retentionPolicies/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /retentionAssignments/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /adminAuthorityContexts/{documentId} { allow read, write: if serverManagedOnly(); }
    match /adminPermissionGrants/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /backgroundJobs/{documentId} { allow read, write: if serverManagedOnly(); }
    match /backgroundJobEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    match /transactionalEmailDeliveries/{documentId} { allow read, write: if serverManagedOnly(); }
    match /transactionalEmailDeliveryEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /acquisitionContexts/{documentId} { allow read, write: if serverManagedOnly(); }
    match /acquisitionContextEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    match /businessReferrals/{documentId} { allow read, write: if serverManagedOnly(); }
    match /businessReferralEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /businessReferralCommands/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    match /rfxAggregates/{documentId} { allow read, write: if serverManagedOnly(); }
    match /rfxEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /rfxCommands/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /rfxPublicationSnapshots/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /rfxOpportunityProjections/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    // DSC-004/005/006/007/008 discovery and relationship state remains server-managed.
    match /opportunitySavedSearches/{documentId} { allow read, write: if serverManagedOnly(); }
    match /opportunityWatches/{documentId} { allow read, write: if serverManagedOnly(); }
    match /opportunitySavedSearchMatches/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /opportunityAlertIntents/{documentId} { allow read, write: if serverManagedOnly(); }
    match /opportunityRelationCommands/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /opportunityRelationEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    // RSP-001/002/003/004/006 pursuit fit and private decisions are server-authoritative.
    // Fit snapshots, command receipts, and events are immutable; the pursuit aggregate is mutable
    // only through trusted current-participant handlers. Direct clients cannot inspect or mutate them.
    match /opportunityFitSnapshots/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /opportunityPursuits/{documentId} { allow read, write: if serverManagedOnly(); }
    match /opportunityPursuitCommands/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /opportunityPursuitEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    match /referralEducationAcknowledgements/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /referralCommunicationIntents/{documentId} { allow read, write: if serverManagedOnly(); }

    match /providerApplications/{documentId} { allow read, write: if serverManagedOnly(); }
    match /providerApplicationVersions/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /providerApplicationEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /providerApplicationCommands/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /officialResourceProviderStatuses/{documentId} { allow read, write: if serverManagedOnly(); }
    match /providerServiceProfiles/{documentId} { allow read, write: if serverManagedOnly(); }
    match /providerDiscoveryPublications/{documentId} { allow read, write: if serverManagedOnly(); }
    match /providerResources/{documentId} { allow read, write: if serverManagedOnly(); }
    match /providerNetworkEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /providerNetworkCommands/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /providerRequestMessages/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /providerAcquisitionInvitations/{documentId} { allow read, write: if serverManagedOnly(); }

    match /networkEducationProgress/{documentId} { allow read, write: if serverManagedOnly(); }
    match /networkEducationEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /networkEducationCommands/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /orientationJourneys/{documentId} { allow read, write: if serverManagedOnly(); }
    match /orientationJourneyEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /firstValueSelections/{documentId} { allow read, write: if serverManagedOnly(); }
    match /activationReleaseEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }

    match /aiInterpretationRecords/{documentId} { allow read, write: if serverManagedOnly(); }
    match /aiInterpretationCandidates/{documentId} { allow read, write: if serverManagedOnly(); }
    match /aiInterpretationProvenance/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /aiInterpretationUsageEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /aiInterpretationEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /aiInterpretationQuotaBuckets/{documentId} { allow read, write: if serverManagedOnly(); }

    // MRFC Critical authority collections remain server-managed.
    match /organizationCommercialAccounts/{documentId} { allow read, write: if serverManagedOnly(); }
    match /commercialFoundingCapacity/{documentId} { allow read, write: if serverManagedOnly(); }
    match /commercialProviderEvents/{documentId} { allow read, create: if serverManagedOnly(); allow update, delete: if false; }
    match /commercialSubscriptionReconciliations/{documentId} { allow read, write: if serverManagedOnly(); }

    match /storedAssets/{documentId} { allow read, write: if serverManagedOnly(); }

    match /{document=**} { allow read, write: if false; }
  }
}
