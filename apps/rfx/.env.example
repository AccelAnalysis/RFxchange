# App Hosting supplies this automatically when associated with RFxchange RFx.
# For local development, paste that Web App's *public* SDK config as JSON:
FIREBASE_WEBAPP_CONFIG=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
RFXCHANGE_ENV=development
RFXCHANGE_EXPECTED_PROJECT_ID=rfxchange
RFXCHANGE_PUBLIC_ORIGIN=http://localhost:3003
RFXCHANGE_LEGACY_EXCHANGE_ORIGIN=https://rfxchange--rfxchange.us-east4.hosted.app
RFXCHANGE_PURCHASING_ORIGIN=https://rfxchange-purchasing.web.app
# Use existing authorized local ADC/emulators for server access. Never paste provider keys here.
