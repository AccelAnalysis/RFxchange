{
  "name": "rfxchange",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "functions",
    "apps/admin",
    "apps/marketing"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "build:functions": "npm --workspace @rfxchange/functions run build",
    "test:functions": "npm --workspace @rfxchange/functions run test",
    "validate:firebase-environment": "node scripts/validate-firebase-environment.mjs",
    "acceptance:microsoft-transactional-email": "node scripts/send-microsoft-transactional-email-acceptance.mjs",
    "validate:internationalization": "node scripts/validate-internationalization.mjs",
    "smoke:resource-provider-foundation": "node --experimental-transform-types --experimental-loader ./scripts/node-typescript-source-loader.mjs scripts/smoke-resource-provider-foundation-emulator.mjs",
    "smoke:resource-network": "node --experimental-transform-types --experimental-loader ./scripts/node-typescript-source-loader.mjs scripts/smoke-resource-network-emulator.mjs",
    "smoke:network-education": "node --experimental-transform-types --experimental-loader ./scripts/node-typescript-source-loader.mjs scripts/smoke-network-education-emulator.mjs",
    "smoke:rfx-kernel": "node --experimental-transform-types --experimental-loader ./scripts/node-typescript-source-loader.mjs scripts/smoke-rfx-kernel-emulator.mjs",
    "smoke:referral-network": "node --experimental-transform-types --experimental-loader ./scripts/node-typescript-source-loader.mjs scripts/smoke-referral-network-emulator.mjs",
    "evaluate:ai-amacs-interpretation": "node scripts/evaluate-ai-amacs-interpretation.mjs",
    "smoke:ai-amacs-interpretation": "node --experimental-transform-types --experimental-loader ./scripts/node-typescript-source-loader.mjs scripts/smoke-ai-amacs-interpretation-emulator.mjs",
    "generate:amacs-0-5": "node scripts/ingest-amacs-release.mjs",
    "test:architecture": "npm test",
    "validate": "npm run validate:internationalization && npm run validate:security",
    "check": "npm run check:fast && npm run test:firebase && npm run check:build",
    "build:admin": "npm --workspace @rfxchange/admin run build",
    "typecheck:admin": "npm --workspace @rfxchange/admin run typecheck",
    "build:marketing": "npm --workspace @rfxchange/marketing run build",
    "typecheck:marketing": "npm --workspace @rfxchange/marketing run typecheck",
    "validate:accelpo": "node scripts/validate-accelpo-chassis.mjs",
    "typecheck:accelpo": "tsc -p apps/accelpo/tsconfig.json",
    "test:accelpo": "node --experimental-transform-types --test test/accelpo-cp*.test.mjs",
    "test:accelpo-cp04": "node --experimental-transform-types --test test/accelpo-cp04-query-projection.test.mjs",
    "validate:security": "npm run validate:firebase-environment",
    "test": "node --experimental-transform-types --test test/*.test.mjs",
    "check:fast": "npm run typecheck && npm run typecheck:admin && npm run typecheck:marketing && npm run typecheck:accelpo && npm run lint && npm run build:functions && npm test && npm run test:functions && npm run validate",
    "smoke:firebase": "node scripts/run-firebase-smoke.mjs",
    "test:firebase": "firebase emulators:exec --only auth,firestore,functions,storage --project demo-rfxchange \"npm run smoke:firebase\"",
    "check:build": "npm run build && node scripts/smoke-pwa-application.mjs && npm run build:admin && node scripts/smoke-admin-application.mjs && npm run build:marketing && node scripts/smoke-marketing-application.mjs",
    "test:browser": "node --experimental-transform-types --experimental-loader ./scripts/node-typescript-source-loader.mjs scripts/smoke-exchange-runtime.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "firebase": "12.16.0",
    "firebase-admin": "14.3.0",
    "mapbox-gl": "3.25.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "15.29.0",
    "nx": "23.2.1",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "qs": "6.16.0",
    "@opentelemetry/core": "^2.8.0",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "firebase-admin": {
      "uuid": "^11.1.1"
    }
  },
  "packageManager": "npm@11.9.0"
}
